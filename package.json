{
  "name": "rodniy-chess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "worker": "node --env-file-if-exists=.env --import tsx server/worker.ts",
    "build": "tsc --noEmit && vite build && node scripts/redirect.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "check:providers": "node --env-file-if-exists=.env --import tsx scripts/check-providers.ts",
    "format": "prettier --write \"{src,server,shared,tests,scripts}/**/*.{ts,tsx,css,mjs}\" *.json *.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stockfish": "^17.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
